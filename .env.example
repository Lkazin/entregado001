# Supabase Configuration (Ambiente de Testes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Privadas, somente no servidor. PIN com 6 numeros; segredo aleatorio >=32 caracteres.
# Sem valores padrao: configure antes de publicar.
ADMIN_ACCESS_PIN=
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_DEFAULT_STORE_SLUG=bella-pizza
NEXT_PUBLIC_DEFAULT_STORE_ID=11111111-1111-1111-1111-111111111111
