# Supabase Configuration
# NUNCA coloque a chave service_role no codigo ou em variaveis NEXT_PUBLIC_*.
# Ela deve existir apenas no servidor (arquivo .env.local ou variaveis do provedor de hospedagem).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_DEFAULT_STORE_SLUG=bella-pizza
NEXT_PUBLIC_DEFAULT_STORE_ID=11111111-1111-1111-1111-111111111111
