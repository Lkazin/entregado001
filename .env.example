# Supabase Configuration (Ambiente de Testes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Privadas, somente no servidor. PIN com 6 numeros; segredo aleatorio >=32 caracteres.
# Sem valores padrao: configure antes de publicar.
ADMIN_ACCESS_PIN=
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_DEFAULT_STORE_SLUG=bella-pizza
NEXT_PUBLIC_DEFAULT_STORE_ID=11111111-1111-1111-1111-111111111111

# Mapas: configurar NO SERVIDOR do lojista (entregado001), em Production.
# Endpoint /search de provedor autorizado compativel com Nominatim.
# Nao usar o servico publico sem cumprir suas regras.
NOMINATIM_SEARCH_URL=
# Opcional: servidor OSRM; o codigo usa o demonstrador OSRM quando ausente.
OSRM_BASE_URL=https://router.project-osrm.org

# Motor privado: servidor do LOJISTA, nunca NEXT_PUBLIC_.
# Local: http://127.0.0.1:8003; Vercel: HTTPS fixo do tunel protegido.
VALHALLA_BASE_URL=
VALHALLA_API_KEY=

# Chave privada do gateway de geocodificacao, somente servidor.
NOMINATIM_API_KEY=
